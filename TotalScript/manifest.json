{
  "manifest_version": 3,
  "name": "TotalScript",
  "version": "1.82.0",
  "minimum_chrome_version": "111",
  "description": "Turn ChatGPT, Claude, DeepSeek, Gemini, Kimi, NVIDIA NIM Kimi K3, GLM, Qwen, Arena, Meta AI, Crax GPT, Notion AI or Ox Alpha into a Roblox Studio / AgentScript agent. Two engines (RS/AS), work modes, image-to-model, auto-fix playtest errors, and Extra Thinking.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "<all_urls>",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.claude.com/*",
    "https://claude.com/*",
    "https://www.claude.ai/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.ai/*",
    "https://www.kimi.ai/*",
    "https://build.nvidia.com/moonshotai/kimi-k3/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://*/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://gpt.crax.lol/*",
    "https://oxalpha.com/*",
    "https://www.oxalpha.com/*",
    "https://oxalpha.org/*",
    "https://www.oxalpha.org/*",
    "https://c.vani.ai/*",
    "https://aistudio.xiaomimimo.com/*",
    "https://app.clickup.com/*",
    "https://codecraftapi.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.roblox.com/*",
    "https://roblox.com/*",
    "https://www.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://develop.roblox.com/*",
    "https://auth.roblox.com/*",
    "https://users.roblox.com/*",
    "https://agent.minimax.io/*",
    "https://overchat.ai/*",
    "https://*.overchat.ai/*",
    "https://huggingface.co/chat/*",
    "https://chat.mistral.ai/*",
    "https://mistral.ai/*",
    "https://openrouter.ai/*",
    "https://www.openrouter.ai/*",
    "https://console.groq.com/*",
    "https://dashboard.cohere.com/*",
    "https://api.together.ai/*",
    "https://fireworks.ai/*",
    "https://app.fireworks.ai/*",
    "https://www.notion.so/*",
    "https://app.notion.so/*",
    "https://www.notion.com/*",
    "https://notion.com/*",
    "https://*.notion.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://* ws://127.0.0.1:* http://127.0.0.1:* http://localhost:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*.jpg",
        "assets/icon.png",
        "assets/icon128.png",
        "assets/gui-studio-mark.png",
        "assets/gui-studio-wordmark.png"
      ],
      "matches": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    },
    {
      "resources": [
        "src/core/project_worker.js",
        "assets/icon128.png",
        "assets/icon.png",
        "assets/gui-studio-mark.png",
        "assets/gui-studio-wordmark.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TotalScript — RS/AS",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

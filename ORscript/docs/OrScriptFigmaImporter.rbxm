<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<roblox version="4">
  <Item class="Model" referent="RBX0">
    <Properties>
      <string name="Name">OrScriptFigmaImporter</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">FigmaImporter</string>
        <ProtectedString name="Source"><![CDATA[-- OrScript Figma importer runtime.
-- The browser bridge reads/edits Figma; this Roblox module applies the
-- validated Figma-to-Roblox UI tree returned by ORscript.
local Importer = {}

local function color(value)
    if type(value) ~= "string" then return nil end
    local r, g, b = value:match("^#(%x%x)(%x%x)(%x%x)$")
    if not r then return nil end
    return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
end

local function make(node, parent)
    assert(type(node) == "table", "Figma node must be a table")
    local className = node.className or "Frame"
    local allowed = {ScreenGui=true, Frame=true, TextLabel=true, TextButton=true, ImageLabel=true}
    local object = Instance.new(allowed[className] and className or "Frame")
    object.Name = tostring(node.name or className)
    object.Parent = parent
    local props = node.properties or {}
    if object:IsA("GuiObject") then
        local size = props.Size or {0, 0}
        local position = props.Position or {0, 0}
        object.Size = UDim2.fromOffset(tonumber(size[1]) or 0, tonumber(size[2]) or 0)
        object.Position = UDim2.fromOffset(tonumber(position[1]) or 0, tonumber(position[2]) or 0)
        local fill = color(props.BackgroundColor)
        if fill then object.BackgroundColor3 = fill end
        if props.BackgroundTransparency ~= nil then object.BackgroundTransparency = tonumber(props.BackgroundTransparency) or 0 end
    end
    if object:IsA("TextLabel") or object:IsA("TextButton") then
        object.Text = tostring(props.Text or "")
        object.TextWrapped = true
    end
    for _, child in ipairs(node.children or {}) do make(child, object) end
    return object
end

function Importer.import(tree, parent)
    assert(typeof(parent) == "Instance", "parent must be an Instance")
    return make(tree, parent)
end

return Importer
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
